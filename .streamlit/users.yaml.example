# Copy to .streamlit/users.yaml (gitignored). Login is email + password.
# password is the sha256 hex of the plaintext. Generate a new one with:
#   python -c "import hashlib;print(hashlib.sha256(b'yourpw').hexdigest())"
# roles gate which data sources a user can query (see auth.ROLE_CAPABILITIES):
#   admin/exec/analyst = all sources · finance = revenue,finance ·
#   sales = revenue,pipeline,custom · marketing = campaigns
# New users can also self-register via the Sign up tab.
users:
  - email: admin@demo.co
    name: Admin
    password: 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9   # admin123
    roles: [admin]
  - email: exec@demo.co
    name: Exec
    password: 0e1a137623819274b1ec55c7354c00c949f54d03653f698e2ce4e1e93de726cc   # exec123
    roles: [exec]
  - email: sales@demo.co
    name: Sales User
    password: 6bc0a63cb29c92306020c0a6bbc358cc4628db277dc06e253535e126517ad637   # sales123
    roles: [sales]
  - email: marketing@demo.co
    name: Marketing User
    password: 7d50137f0395e9a47a5daf16959dd68abef6370d3b837ec3be4fe9d869db46a3   # marketing123
    roles: [marketing]
